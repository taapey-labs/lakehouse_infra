AWSTemplateFormatVersion: '2010-09-09'
Description: >-
  Customer-managed VPC for Databricks SRA custom network (HYBRID compute).
  Mirrors SRA isolated networking (no IGW, no NAT, private compute subnets,
  dedicated PrivateLink subnets, S3/STS/Kinesis plus Databricks REST and SCC
  interface endpoints) so the IDs can be passed into SRA as custom_vpc_id,
  custom_private_subnet_ids, custom_sg_id, custom_general_access_vpce_id, and
  custom_scc_relay_vpce_id.
  SCC private DNS is left off; a Route 53 zone pins
  tunnel.privatelink.cloud.databricks.com to the SCC endpoint so it does not
  collide with REST ncalifornia.privatelink.cloud.databricks.com.
  Refs:
  https://databricks.github.io/terraform-databricks-sra/docs/usage/AWS/gettingstarted/
  https://docs.databricks.com/aws/en/security/network/classic/customer-managed-vpc

Metadata:
  AWS::CloudFormation::Interface:
    ParameterGroups:
      - Label:
          default: Naming
        Parameters:
          - ProjectName
      - Label:
          default: VPC and subnets (SRA isolated-style CIDRs, two AZs)
        Parameters:
          - VpcCidr
          - WorkspaceSubnetACidr
          - WorkspaceSubnetBCidr
          - PrivateLinkSubnetACidr
          - PrivateLinkSubnetBCidr
          - AvailabilityZoneA
          - AvailabilityZoneB
      - Label:
          default: Databricks PrivateLink service names
        Parameters:
          - DatabricksWorkspaceVpceServiceName
          - DatabricksSccRelayVpceServiceName
      - Label:
          default: Optional overrides
        Parameters:
          - S3PrefixListId

Mappings:
  S3PrefixList:
    us-east-1:
      Id: pl-63a5400a
    us-east-2:
      Id: pl-7ba54012
    us-west-1:
      Id: pl-6ba54002
    us-west-2:
      Id: pl-68a54001
    eu-west-1:
      Id: pl-6da54004
    ap-southeast-1:
      Id: pl-31a34658
    ap-southeast-2:
      Id: pl-b8a742d1
    ap-northeast-1:
      Id: pl-61a54008
    ap-south-1:
      Id: pl-78a54011
    ca-central-1:
      Id: pl-38a64351

Parameters:
  ProjectName:
    Type: String
    Default: lakehouse
    Description: Name prefix used for resources (align with SRA resource_prefix)

  VpcCidr:
    Type: String
    Default: 10.10.0.0/18
    Description: >-
      VPC CIDR. Default matches a two-AZ SRA isolated layout. All workspace and
      PrivateLink subnets must fall inside this block (no secondary CIDR).

  WorkspaceSubnetACidr:
    Type: String
    Default: 10.10.0.0/22
    Description: Classic compute (workspace) subnet A. Databricks requires at least /26; SRA isolated uses /22.

  WorkspaceSubnetBCidr:
    Type: String
    Default: 10.10.4.0/22
    Description: Classic compute (workspace) subnet B in a second AZ.

  PrivateLinkSubnetACidr:
    Type: String
    Default: 10.10.28.0/26
    Description: Dedicated PrivateLink subnet A (STS, Kinesis, Databricks REST/SCC). Do not use as a workspace subnet.

  PrivateLinkSubnetBCidr:
    Type: String
    Default: 10.10.28.64/26
    Description: Dedicated PrivateLink subnet B.

  AvailabilityZoneA:
    Type: AWS::EC2::AvailabilityZone::Name
    Description: AZ for workspace and PrivateLink subnet A (us-west-1 has two AZs)

  AvailabilityZoneB:
    Type: AWS::EC2::AvailabilityZone::Name
    Description: AZ for workspace and PrivateLink subnet B

  DatabricksWorkspaceVpceServiceName:
    Type: String
    Default: com.amazonaws.vpce.us-west-1.vpce-svc-09bb6ca26208063f2
    Description: >-
      Databricks workspace REST (general access) PrivateLink service name.
      Default is us-west-1. Other regions:
      https://docs.databricks.com/aws/en/resources/ip-domain-region#privatelink

  DatabricksSccRelayVpceServiceName:
    Type: String
    Default: com.amazonaws.vpce.us-west-1.vpce-svc-04cb91f9372b792fe
    Description: Databricks SCC relay PrivateLink service name. Default is us-west-1.

  S3PrefixListId:
    Type: String
    Default: ''
    Description: >-
      Override for the AWS-managed S3 prefix list ID used in workspace SG egress.
      Leave empty to use the regional mapping (us-west-1 is pl-6ba54002).

Conditions:
  UseS3PrefixListOverride: !Not
    - !Equals
      - !Ref S3PrefixListId
      - ''

Resources:
  Vpc:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: !Ref VpcCidr
      EnableDnsSupport: true
      EnableDnsHostnames: true
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-classic-compute-plane-vpc
        - Key: Project
          Value: !Ref ProjectName

  WorkspaceSubnetA:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref WorkspaceSubnetACidr
      AvailabilityZone: !Ref AvailabilityZoneA
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-private-${AvailabilityZoneA}
        - Key: Project
          Value: !Ref ProjectName

  WorkspaceSubnetB:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref WorkspaceSubnetBCidr
      AvailabilityZone: !Ref AvailabilityZoneB
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-private-${AvailabilityZoneB}
        - Key: Project
          Value: !Ref ProjectName

  PrivateLinkSubnetA:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref PrivateLinkSubnetACidr
      AvailabilityZone: !Ref AvailabilityZoneA
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-privatelink-${AvailabilityZoneA}
        - Key: Project
          Value: !Ref ProjectName

  PrivateLinkSubnetB:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref PrivateLinkSubnetBCidr
      AvailabilityZone: !Ref AvailabilityZoneB
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-privatelink-${AvailabilityZoneB}
        - Key: Project
          Value: !Ref ProjectName

  PrivateRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-private-rt
        - Key: Project
          Value: !Ref ProjectName

  PrivateLinkRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-privatelink-rt
        - Key: Project
          Value: !Ref ProjectName

  WorkspaceSubnetARouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref WorkspaceSubnetA
      RouteTableId: !Ref PrivateRouteTable

  WorkspaceSubnetBRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref WorkspaceSubnetB
      RouteTableId: !Ref PrivateRouteTable

  PrivateLinkSubnetARouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref PrivateLinkSubnetA
      RouteTableId: !Ref PrivateLinkRouteTable

  PrivateLinkSubnetBRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref PrivateLinkSubnetB
      RouteTableId: !Ref PrivateLinkRouteTable

  # Inline CIDR/prefix-list egress replaces the default allow-all. Self-references
  # are separate resources so CloudFormation does not see a circular dependency.
  DatabricksWorkspaceSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Databricks workspace SG (SRA isolated-style, custom VPC)
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-workspace-sg
        - Key: Project
          Value: !Ref ProjectName
      SecurityGroupEgress:
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          CidrIp: !Ref VpcCidr
          Description: HTTPS to PrivateLink ENIs
        - IpProtocol: tcp
          FromPort: 2443
          ToPort: 2443
          CidrIp: !Ref VpcCidr
          Description: SCC FIPS / ngrok
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          CidrIp: !Ref VpcCidr
          Description: Lakebase PostgreSQL
        - IpProtocol: tcp
          FromPort: 6666
          ToPort: 6666
          CidrIp: !Ref VpcCidr
          Description: SCC relay
        - IpProtocol: tcp
          FromPort: 8443
          ToPort: 8451
          CidrIp: !Ref VpcCidr
          Description: Control plane API / UC logging / future
        - IpProtocol: tcp
          FromPort: 53
          ToPort: 53
          CidrIp: !Ref VpcCidr
          Description: DNS TCP
        - IpProtocol: udp
          FromPort: 53
          ToPort: 53
          CidrIp: !Ref VpcCidr
          Description: DNS UDP
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          DestinationPrefixListId: !If
            - UseS3PrefixListOverride
            - !Ref S3PrefixListId
            - !FindInMap
              - S3PrefixList
              - !Ref AWS::Region
              - Id
          Description: S3 via gateway endpoint

  SgIngressSelfTcp:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 0
      ToPort: 65535
      SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
      Description: Internode TCP

  SgIngressSelfUdp:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: udp
      FromPort: 0
      ToPort: 65535
      SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
      Description: Internode UDP

  SgEgressSelfTcp:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 0
      ToPort: 65535
      DestinationSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
      Description: Internode TCP

  SgEgressSelfUdp:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: udp
      FromPort: 0
      ToPort: 65535
      DestinationSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
      Description: Internode UDP

  DatabricksEndpointSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: PrivateLink endpoint SG for Databricks and AWS interface endpoints
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-privatelink-sg
        - Key: Project
          Value: !Ref ProjectName
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: REST / STS / Kinesis
        - IpProtocol: tcp
          FromPort: 6666
          ToPort: 6666
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: SCC relay
        - IpProtocol: tcp
          FromPort: 2443
          ToPort: 2443
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: SCC FIPS
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: Lakebase
        - IpProtocol: tcp
          FromPort: 8443
          ToPort: 8443
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: Control plane API
        - IpProtocol: tcp
          FromPort: 8444
          ToPort: 8444
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: UC logging and lineage
        - IpProtocol: tcp
          FromPort: 8445
          ToPort: 8451
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
          Description: Future extendability

  S3GatewayEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.s3
      VpcEndpointType: Gateway
      RouteTableIds:
        - !Ref PrivateRouteTable
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-s3-vpc-endpoint
        - Key: Project
          Value: !Ref ProjectName

  StsVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.sts
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref PrivateLinkSubnetA
        - !Ref PrivateLinkSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-sts-vpc-endpoint
        - Key: Project
          Value: !Ref ProjectName

  KinesisVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.kinesis-streams
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref PrivateLinkSubnetA
        - !Ref PrivateLinkSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-kinesis-vpc-endpoint
        - Key: Project
          Value: !Ref ProjectName

  DatabricksWorkspaceVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Ref DatabricksWorkspaceVpceServiceName
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref PrivateLinkSubnetA
        - !Ref PrivateLinkSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-general-access
        - Key: Project
          Value: !Ref ProjectName

  DatabricksSccRelayVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Ref DatabricksSccRelayVpceServiceName
      VpcEndpointType: Interface
      PrivateDnsEnabled: false
      SubnetIds:
        - !Ref PrivateLinkSubnetA
        - !Ref PrivateLinkSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-dataplane-relay
        - Key: Project
          Value: !Ref ProjectName

  SccRelayPrivateHostedZone:
    Type: AWS::Route53::HostedZone
    DependsOn: DatabricksSccRelayVpcEndpoint
    Properties:
      Name: tunnel.privatelink.cloud.databricks.com
      VPCs:
        - VPCId: !Ref Vpc
          VPCRegion: !Ref AWS::Region
      HostedZoneConfig:
        Comment: Pin Databricks SCC relay PrivateLink to the relay VPC endpoint
      HostedZoneTags:
        - Key: Name
          Value: !Sub ${ProjectName}-scc-tunnel-zone
        - Key: Project
          Value: !Ref ProjectName

  SccRelayTunnelRecord:
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref SccRelayPrivateHostedZone
      Name: tunnel.privatelink.cloud.databricks.com
      Type: A
      AliasTarget:
        HostedZoneId: !Select
          - 0
          - !Split
            - ':'
            - !Select
              - 0
              - !GetAtt DatabricksSccRelayVpcEndpoint.DnsEntries
        DNSName: !Select
          - 1
          - !Split
            - ':'
            - !Select
              - 0
              - !GetAtt DatabricksSccRelayVpcEndpoint.DnsEntries
        EvaluateTargetHealth: false

Outputs:
  VpcId:
    Description: custom_vpc_id for SRA
    Value: !Ref Vpc
  WorkspaceSubnetAId:
    Description: First custom_private_subnet_ids value
    Value: !Ref WorkspaceSubnetA
  WorkspaceSubnetBId:
    Description: Second custom_private_subnet_ids value
    Value: !Ref WorkspaceSubnetB
  PrivateLinkSubnetAId:
    Description: PrivateLink subnet A (not a workspace subnet)
    Value: !Ref PrivateLinkSubnetA
  PrivateLinkSubnetBId:
    Description: PrivateLink subnet B (not a workspace subnet)
    Value: !Ref PrivateLinkSubnetB
  DatabricksSecurityGroupId:
    Description: custom_sg_id for SRA
    Value: !Ref DatabricksWorkspaceSecurityGroup
  DatabricksWorkspaceVpcEndpointId:
    Description: custom_general_access_vpce_id for SRA
    Value: !Ref DatabricksWorkspaceVpcEndpoint
  DatabricksSccRelayVpcEndpointId:
    Description: custom_scc_relay_vpce_id for SRA
    Value: !Ref DatabricksSccRelayVpcEndpoint
  StsVpcEndpointId:
    Value: !Ref StsVpcEndpoint
  KinesisVpcEndpointId:
    Value: !Ref KinesisVpcEndpoint
  S3GatewayEndpointId:
    Value: !Ref S3GatewayEndpoint
