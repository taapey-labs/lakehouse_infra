AWSTemplateFormatVersion: '2010-09-09'
Description: 'Customer-managed VPC for a Databricks classic workspace. Creates a
  /25 VPC with two private /26 workspace subnets (one per AZ), two public /26
  endpoint subnets (one per AZ), the required Databricks security group, and
  AWS PrivateLink interface endpoints (front-end + back-end) for private
  connectivity to Databricks. Ref:
  https://docs.databricks.com/aws/en/security/network/classic/customer-managed-vpc'

Parameters:
  ProjectName:
    Type: String
    Default: lakehouse
    Description: Name prefix used for resources

  VpcCidr:
    Type: String
    Default: 10.10.0.0/25
    Description: Primary VPC CIDR (/25), fully consumed by the two /26 workspace subnets

  PublicEndpointCidr:
    Type: String
    Default: 10.10.2.0/24
    Description: Secondary VPC CIDR block reserved for the two public endpoint subnets

  WorkspaceSubnetACidr:
    Type: String
    Default: 10.10.0.0/26
    Description: Databricks private workspace subnet A (/26)

  WorkspaceSubnetBCidr:
    Type: String
    Default: 10.10.0.64/26
    Description: Databricks private workspace subnet B (/26)

  PublicEndpointSubnetACidr:
    Type: String
    Default: 10.10.2.0/26
    Description: Public endpoint subnet A for Databricks-facing VPC endpoints (STS/Kinesis)

  PublicEndpointSubnetBCidr:
    Type: String
    Default: 10.10.2.64/26
    Description: Public endpoint subnet B for Databricks-facing VPC endpoints (STS/Kinesis)

  AvailabilityZoneA:
    Type: AWS::EC2::AvailabilityZone::Name
    Description: AZ for workspace subnet A

  AvailabilityZoneB:
    Type: AWS::EC2::AvailabilityZone::Name
    Description: AZ for workspace subnet B

  DatabricksWorkspaceVpceServiceName:
    Type: String
    Description: 'AWS PrivateLink service name for the Databricks workspace (REST
      API) endpoint. Region-specific; look up the exact value for your workspace
      region in the "PrivateLink VPC endpoint services" table:
      https://docs.databricks.com/aws/en/resources/ip-domain-region#privatelink
      Format: com.amazonaws.vpce.<region>.vpce-svc-xxxxxxxxxxxxxxxxx'

  DatabricksSccRelayVpceServiceName:
    Type: String
    Description: 'AWS PrivateLink service name for the Databricks secure cluster
      connectivity (SCC) relay. Region-specific; look up the exact value for
      your workspace region in the "PrivateLink VPC endpoint services" table:
      https://docs.databricks.com/aws/en/resources/ip-domain-region#privatelink
      Format: com.amazonaws.vpce.<region>.vpce-svc-xxxxxxxxxxxxxxxxx'

Resources:
  Vpc:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: !Ref VpcCidr
      EnableDnsSupport: true
      EnableDnsHostnames: true
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-vpc

  PublicEndpointCidrBlock:
    Type: AWS::EC2::VPCCidrBlock
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref PublicEndpointCidr

  # --- Databricks private workspace subnets (2x /26, one per AZ) ---
  WorkspaceSubnetA:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref WorkspaceSubnetACidr
      AvailabilityZone: !Ref AvailabilityZoneA
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-private-a

  WorkspaceSubnetB:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref WorkspaceSubnetBCidr
      AvailabilityZone: !Ref AvailabilityZoneB
      MapPublicIpOnLaunch: false
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-private-b

  # --- Public subnets for Databricks public endpoint resources (S3/STS/Kinesis) ---
  PublicEndpointSubnetA:
    Type: AWS::EC2::Subnet
    DependsOn: PublicEndpointCidrBlock
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref PublicEndpointSubnetACidr
      AvailabilityZone: !Ref AvailabilityZoneA
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-public-endpoint-a

  PublicEndpointSubnetB:
    Type: AWS::EC2::Subnet
    DependsOn: PublicEndpointCidrBlock
    Properties:
      VpcId: !Ref Vpc
      CidrBlock: !Ref PublicEndpointSubnetBCidr
      AvailabilityZone: !Ref AvailabilityZoneB
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-public-endpoint-b

  PublicRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-public-rt

  PublicEndpointSubnetARouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref PublicEndpointSubnetA
      RouteTableId: !Ref PublicRouteTable

  PublicEndpointSubnetBRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref PublicEndpointSubnetB
      RouteTableId: !Ref PublicRouteTable

  # --- Private route table for the two workspace subnets (no NAT; rely on PrivateLink and public endpoint subnets) ---
  PrivateRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-private-rt

  WorkspaceSubnetARouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref WorkspaceSubnetA
      RouteTableId: !Ref PrivateRouteTable

  WorkspaceSubnetBRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref WorkspaceSubnetB
      RouteTableId: !Ref PrivateRouteTable

  # --- Security group for the Databricks workspace (rules per docs) ---
  DatabricksWorkspaceSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Databricks workspace security group
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-sg

  SgIngressSelfTcp:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 0
      ToPort: 65535
      SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup

  SgIngressSelfUdp:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: udp
      FromPort: 0
      ToPort: 65535
      SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup

  SgEgressSelfTcp:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 0
      ToPort: 65535
      DestinationSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup

  SgEgressSelfUdp:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: udp
      FromPort: 0
      ToPort: 65535
      DestinationSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup

  SgEgressHttps:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

  SgEgressHiveMetastore:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 3306
      ToPort: 3306
      CidrIp: 0.0.0.0/0

  SgEgressDns:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 53
      ToPort: 53
      CidrIp: 0.0.0.0/0

  SgEgressSccRelay:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 6666
      ToPort: 6666
      CidrIp: 0.0.0.0/0

  # FIPS / ngrok SCC relay over PrivateLink uses tunnel.privatelink.cloud.databricks.com:2443
  SgEgressSccRelayFips:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 2443
      ToPort: 2443
      CidrIp: 0.0.0.0/0

  SgEgressDnsUdp:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: udp
      FromPort: 53
      ToPort: 53
      CidrIp: 0.0.0.0/0

  SgEgressControlPlaneApi:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId: !Ref DatabricksWorkspaceSecurityGroup
      IpProtocol: tcp
      FromPort: 8443
      ToPort: 8451
      CidrIp: 0.0.0.0/0

  # --- Dedicated security group for the VPC (PrivateLink) interface endpoints ---
  DatabricksEndpointSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Databricks PrivateLink VPC interface endpoints
      VpcId: !Ref Vpc
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
        - IpProtocol: tcp
          FromPort: 6666
          ToPort: 6666
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
        - IpProtocol: tcp
          FromPort: 2443
          ToPort: 2443
          SourceSecurityGroupId: !Ref DatabricksWorkspaceSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub ${ProjectName}-databricks-vpce-sg

  # --- Gateway endpoint for S3 ---
  S3GatewayEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.s3
      VpcEndpointType: Gateway
      RouteTableIds:
        - !Ref PrivateRouteTable
        - !Ref PublicRouteTable

  # --- Interface endpoints for public egress-dependent AWS services (STS, Kinesis) ---
  StsVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.sts
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref PublicEndpointSubnetA
        - !Ref PublicEndpointSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup

  KinesisVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Sub com.amazonaws.${AWS::Region}.kinesis-streams
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref PublicEndpointSubnetA
        - !Ref PublicEndpointSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup

  # --- Private (PrivateLink) endpoints for Databricks front-end/back-end connectivity ---
  DatabricksWorkspaceVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Ref DatabricksWorkspaceVpceServiceName
      VpcEndpointType: Interface
      PrivateDnsEnabled: true
      SubnetIds:
        - !Ref WorkspaceSubnetA
        - !Ref WorkspaceSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup

  DatabricksSccRelayVpcEndpoint:
    Type: AWS::EC2::VPCEndpoint
    Properties:
      VpcId: !Ref Vpc
      ServiceName: !Ref DatabricksSccRelayVpceServiceName
      VpcEndpointType: Interface
      PrivateDnsEnabled: false
      SubnetIds:
        - !Ref WorkspaceSubnetA
        - !Ref WorkspaceSubnetB
      SecurityGroupIds:
        - !Ref DatabricksEndpointSecurityGroup

  SccRelayPrivateHostedZone:
    Type: AWS::Route53::HostedZone
    DependsOn: DatabricksSccRelayVpcEndpoint
    Properties:
      Name: tunnel.privatelink.cloud.databricks.com
      VPCs:
        - VPCId: !Ref Vpc
          VPCRegion: !Ref AWS::Region
      HostedZoneConfig:
        Comment: Pin Databricks SCC relay PrivateLink to the relay VPC endpoint

  SccRelayTunnelRecord:
    Type: AWS::Route53::RecordSet
    DependsOn:
      - DatabricksSccRelayVpcEndpoint
      - SccRelayPrivateHostedZone
    Properties:
      HostedZoneId: !Ref SccRelayPrivateHostedZone
      Name: tunnel.privatelink.cloud.databricks.com
      Type: A
      AliasTarget:
        HostedZoneId: !Select
          - 0
          - !Split
            - ':'
            - !Select
              - 0
              - !GetAtt DatabricksSccRelayVpcEndpoint.DnsEntries
        DNSName: !Select
          - 1
          - !Split
            - ':'
            - !Select
              - 0
              - !GetAtt DatabricksSccRelayVpcEndpoint.DnsEntries
        EvaluateTargetHealth: false

Outputs:
  VpcId:
    Value: !Ref Vpc
  WorkspaceSubnetAId:
    Value: !Ref WorkspaceSubnetA
  WorkspaceSubnetBId:
    Value: !Ref WorkspaceSubnetB
  PublicEndpointSubnetAId:
    Value: !Ref PublicEndpointSubnetA
  PublicEndpointSubnetBId:
    Value: !Ref PublicEndpointSubnetB
  DatabricksSecurityGroupId:
    Value: !Ref DatabricksWorkspaceSecurityGroup
  DatabricksWorkspaceVpcEndpointId:
    Value: !Ref DatabricksWorkspaceVpcEndpoint
  DatabricksSccRelayVpcEndpointId:
    Value: !Ref DatabricksSccRelayVpcEndpoint